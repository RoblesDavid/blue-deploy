# =============================================================================
# BlueDeploy — Variables de entorno para PRODUCCIÓN (Hetzner)
# Copiar a .env y rellenar antes de ejecutar docker compose -f docker-compose.prod.yml up
# NUNCA commitear el archivo .env real — contiene secretos
# =============================================================================

# ── Base de datos MariaDB ─────────────────────────────────────────────────────
DB_NAME=bluedeploy_prod
DB_USER=bluedeploy_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_SEGURA
DB_ROOT_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_ROOT_SEGURA

# ── Aplicación Spring Boot ────────────────────────────────────────────────────
# Perfil activo (prod usa application-prod.properties si existe)
SPRING_PROFILES_ACTIVE=prod

# ── (Práctica 2) Autenticación JWT ───────────────────────────────────────────
# JWT_SECRET=cambia_por_cadena_aleatoria_de_64_caracteres
# JWT_EXPIRATION_MS=86400000

# ── (Práctica 2) API Key para scripts PowerShell ─────────────────────────────
# API_KEY=cambia_por_clave_aleatoria_segura

# ── Notas de seguridad ────────────────────────────────────────────────────────
# · Las contraseñas deben tener mínimo 20 caracteres con mayúsculas, números y símbolos
# · Genera contraseñas con: openssl rand -base64 32
# · Guarda el .env en un gestor de contraseñas (Bitwarden, 1Password, etc.)

# =============================================================================
# BlueDeploy — Variables de entorno para PRODUCCIÓN (Hetzner)
# Copiar a .env y rellenar antes de ejecutar docker compose -f docker-compose.prod.yml up
# NUNCA commitear el archivo .env real con secretos al repositorio
# =============================================================================

# ── Base de datos MariaDB ─────────────────────────────────────────────────────
DB_NAME=bluedeploy_prod
DB_USER=bluedeploy_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA_MIN24_CARACTERES
DB_ROOT_PASSWORD=CAMBIA_ESTA_CONTRASENA_ROOT_SEGURA_MIN24_CARACTERES

# ── Aplicación Spring Boot ────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Autenticación JWT (Práctica 2) ───────────────────────────────────────────
# Clave HMAC-SHA256 Base64 o de al menos 32-64 bytes aleatorios
# Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIA_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_64_CARACTERES_ALEATORIOS
JWT_EXPIRATION_MS=86400000

# ── API Key para Ingesta desde Scripts PowerShell (Práctica 2) ────────────────
# Generar con: openssl rand -hex 32
BLUEDEPLOY_API_KEY=CAMBIA_POR_API_KEY_ALEATORIA_ALFANUMERICA_SEGURA

# ── Política CORS ─────────────────────────────────────────────────────────────
# Lista separada por comas de dominios permitidos (ej. https://bluedeploy.tudominio.es)
CORS_ALLOWED_ORIGINS=https://bluedeploy.tudominio.es,http://localhost:5173

# ── Notas de seguridad y buenas prácticas ─────────────────────────────────────
# · Las contraseñas y claves deben tener alta entropía
# · Asignar permisos restrictivos al archivo: chmod 600 .env
